        .header {
            grid-area: header;
            border-bottom: 2px solid #333;
            padding-bottom: 10px;
            display: flex;
            align-items: center;
        }

        .main-title {
            font-size: 28px;
            font-weight: bold;
            text-transform: uppercase;
