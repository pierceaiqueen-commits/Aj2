            border-right: 2px solid #333;
            padding-right: 20px;
        }

        .section-text {
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 20px;
            color: #333;
        }

        .section-number {
            font-weight: bold;
            font-size: 16px;
        }

        .read-more {
            color: #0056b3;
            text-decoration: none;
            cursor: pointer;
        }

        .call-to-action {
            font-size: 14px;
            font-weight: bold;
            margin-top: 20px;
            color: #222;
        }

        .social-options {
            list-style-type: none;
            padding: 0;
            margin-top: 20px;
            font-size: 16px;
        }

        .social-options li {
            margin-bottom: 10px;
        }

        .social-options li::before {
            content: "• ";
        }

        /* --- Right Sidebar --- */
        .right-sidebar {
            grid-area: right-sidebar;
            padding-left: 10px;
        }

        .donate-box, .ask-box {
            border: 2px solid #333;
            padding: 15px;
            margin-bottom: 20px;
            background-color: #fdfdfd;
        }

        .box-title {
            font-size: 18px;
            font-weight: bold;
            text-transform: uppercase;
            margin-top: 0;
            margin-bottom: 10px;
            border-bottom: 1px solid black;
        }

        .box-subtitle {
            font-size: 12px;
            font-weight: normal;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .donate-list {
            list-style-type: none;
            padding: 0;
            margin: 0;
            font-size: 12px;
            line-height: 1.6;
        }

        .donate-list li {
            display: flex;
            align-items: flex-start;
            margin-bottom: 8px;
        }

        .donate-list li::before {
            content: "* ";
            margin-right: 8px;
            color: #333;
        }

        .ask-box {
            font-size: 12px;
            line-height: 1.5;
        }

        /* --- Footer --- */
        .footer {
            grid-area: footer;
            text-align: center;
            padding-top: 20px;
            border-top: 2px solid #333;
        }

        .final-cta {
            display: inline-block;
            background-color: #eee;
            border: 2px solid #333;
            color: black;
            padding: 15px 30px;
            text-transform: uppercase;
            font-weight: bold;
            font-size: 16px;
            width: 100%;
            cursor: pointer;
        }

        @media (max-width: 600px) {
            .page-container {
                grid-template-columns: 1fr;
                grid-template-areas:
                    "header"
                    "main"
                    "right-sidebar"
                    "footer";
            }
            .main {
                border-right: none;
                padding-right: 0;
            }
            .right-sidebar {
                padding-left: 0;
            }
        }
    </style>
</head>
