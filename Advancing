                summary: "Public evidence exists of Federal Judges concealing known federal violations in Fresno federal court..."
              }
            ]
          }
        };

        // Define the AI Sync Controller Interface
        window.AIAgentInterface = {
          connectAI: function(agentId) {
            const logEntry = {
              timestamp: new Date().toISOString(),
              event: "AI_CONNECTED",
              agentId: agentId || "UNKNOWN_AI",
              url: window.location.href
            };
            window.AI_PAGE_STATE.activityLog.push(logEntry);
            window.AI_PAGE_STATE.lastSyncTime = logEntry.timestamp;
            return { success: true, status: "SYNCED", state: window.AI_PAGE_STATE };
          },

          getPageData: function() {
            window.AI_PAGE_STATE.currentUrl = window.location.href;
            return window.AI_PAGE_STATE;
          },

          triggerAction: function(actionType, payload) {
            const timestamp = new Date().toISOString();
            let result = { success: true, action: actionType, url: window.location.href };

            window.AI_PAGE_STATE.activityLog.push({
              timestamp: timestamp,
              event: "AI_ACTION_EXECUTED",
              action: actionType,
              details: payload || {}
            });

            return result;
          }
        };

        // Dispatch initial event once page renders
        window.dispatchEvent(new CustomEvent('AIPageReady', {
          detail: {
            interface: window.AIAgentInterface,
            url: window.location.href,
            timestamp: window.AI_PAGE_STATE.lastSyncTime
          }
        }));
      })();
    </script>
