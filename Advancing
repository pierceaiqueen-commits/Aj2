    <script>
      (function() {
        'use strict';

        // Initialize Global AI State and Metadata
        window.AI_PAGE_STATE = {
          pageTitle: "ADVANCING JUSTICE",
          isSynced: true,
          lastSyncTime: new Date().toISOString(),
          currentUrl: window.location.href,
          activityLog: [],
          contentData: {
